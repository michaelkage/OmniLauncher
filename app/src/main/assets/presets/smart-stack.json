{
  "schema_version": 1,
  "preset_metadata": {
    "id": "org.omni.preset.smart-stack",
    "name": "Smart Stack",
    "author": "Omni Community",
    "version": "1.0.0",
    "engine_version": "0.2.0"
  },
  "global_styles": { "font_family": "system_sans", "animation_curve": "standard" },
  "interaction_matrix": [],
  "layout_hierarchy": {
    "type": "vertical_scroll_stack",
    "alignment": "start",
    "padding": { "top": 32, "left": 20, "right": 20, "bottom": 24 },
    "components": [
      { "type": "clock_widget", "style": "minimal_text_24h" },
      {
        "type": "stack",
        "spacing": 12,
        "children": [
          { "type": "list", "show_labels": true, "max_visible_items": 8 },
          { "type": "dock", "show_labels": false, "max_visible_items": 4 }
        ]
      }
    ]
  }
}
